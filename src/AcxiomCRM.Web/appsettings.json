{
  "ConnectionStrings": { "Default": "Data Source=App_Data/acxiomcrm.db" },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "Clock": { "TimeZoneId": "Asia/Kolkata" },
  "Security": {
    "RequireHttps": false,
    "UseForwardedHeaders": false,
    "SessionMinutes": 30,
    "AllowSelfRegistration": true,
    "ManagerCanViewUsers": true,
    "ManagerCanViewAudit": true,
    "PasswordHistoryCount": 5,
    "ResetTokenHours": 2,
    "AuthRateLimitPerMinute": 10,
    "Password": { "RequiredLength": 8, "RequireDigit": true, "RequireLowercase": true, "RequireUppercase": true, "RequireNonAlphanumeric": true, "RequiredUniqueChars": 4 },
    "Lockout": { "MaxFailedAttempts": 5, "Minutes": 15 }
  },
  "Jwt": { "Issuer": "AcxiomCRM", "Audience": "AcxiomCRM.Api", "ExpiryMinutes": 60, "Key": "" },
  "Swagger": { "Enabled": false },
  "Seed": { "AdminEmail": "", "AdminPassword": "", "AdminName": "System Administrator", "DemoData": false, "DemoPassword": "" }
}
