@model LeadDetailsViewModel
@{ var l = Model.Lead; ViewData["Title"] = l.LeadName; var converted = l.Status == nameof(LeadStatus.Converted); }
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-route-action="Index" asp-route="default">Leads</a></li><li class="breadcrumb-item active" aria-current="page">@l.LeadCode</li></ol></nav>
<div class="page-header">
  <div><h1>@l.LeadName</h1><div class="sub">@(l.CompanyName ?? "No company") · <span class="badge-soft badge-soft-@Ui.Badge(l.Status)">@l.Status</span> · <span class="badge-soft badge-soft-@Ui.Badge(l.Priority)">@l.Priority priority</span></div></div>
  <div class="d-flex flex-wrap gap-2">
    @if (l.Status == nameof(LeadStatus.Qualified)) { <a class="btn btn-success" asp-route-action="Convert" asp-route-id="@l.LeadId" asp-route="default"><i class="bi bi-arrow-repeat me-1"></i>Convert</a> }
    @if (!converted)
    {
      <a class="btn btn-outline-primary" asp-route-controller="FollowUps" asp-route-action="Create" asp-route-relatedType="Lead" asp-route-relatedId="@l.LeadId" asp-route="default"><i class="bi bi-calendar-plus me-1"></i>Schedule follow-up</a>
      <a class="btn btn-outline-primary" asp-route-controller="Activities" asp-route-action="Create" asp-route-leadId="@l.LeadId" asp-route="default"><i class="bi bi-telephone-plus me-1"></i>Log activity</a>
      <a class="btn btn-primary" asp-route-action="Edit" asp-route-id="@l.LeadId" asp-route="default"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
    @if (Model.CanDelete)
    {
      <form method="post" asp-route-action="Delete" asp-route-id="@l.LeadId" data-confirm="Delete lead @l.LeadName?" data-confirm-title="Delete lead" data-confirm-ok="Delete" asp-route="default"><button class="btn btn-outline-danger" type="submit" data-no-lock><i class="bi bi-trash me-1"></i>Delete</button></form>
    }
  </div>
</div>
@if (!converted && Model.NextStatuses.Count > 0)
{
  <div class="card mb-3"><div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
    <span class="sub-text fw-semibold text-uppercase me-2">Move to</span>
    @foreach (var s in Model.NextStatuses)
    {
      <form method="post" asp-route-action="ChangeStatus" asp-route-id="@l.LeadId" asp-route="default"><input type="hidden" name="status" value="@s" /><button class="btn btn-sm btn-outline-@Ui.Badge(s.ToString())" type="submit">@s</button></form>
    }
  </div></div>
}
<div class="row g-3">
  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-header">Details</div><div class="card-body"><dl class="detail-list mb-0">
      <dt>Email</dt><dd>@if (l.Email is not null) { <a href="mailto:@l.Email">@l.Email</a> } else { <span>—</span> }</dd>
      <dt>Phone</dt><dd>@(l.Phone ?? "—")</dd>
      <dt>Source</dt><dd>@Ui.Spaced(l.Source)</dd>
      <dt>Expected value</dt><dd>@Ui.Money(l.ExpectedValue)</dd>
      <dt>Assigned to</dt><dd>@l.AssignedToName</dd>
      <dt>Created</dt><dd>@Clock.ToLocal(l.CreatedDate).ToString("dd MMM yyyy")</dd>
      @if (converted) { <dt>Converted</dt><dd>@l.ConvertedDate?.ToString("dd MMM yyyy") · <a asp-route-controller="Customers" asp-route-action="Details" asp-route-id="@l.ConvertedCustomerId" asp-route="default">Customer</a>@if (l.ConvertedOpportunityId is not null) { <text> · </text><a asp-route-controller="Opportunities" asp-route-action="Details" asp-route-id="@l.ConvertedOpportunityId" asp-route="default">Opportunity</a> }</dd> }
      <dt>Notes</dt><dd class="pre-wrap mb-0">@(l.Notes ?? "—")</dd>
    </dl></div></div>
    <div class="card"><div class="card-header">History</div><div class="card-body">
      @if (Model.History.Count == 0) { <span class="text-muted">No recorded changes.</span> }
      else { <ul class="timeline small">@foreach (var h in Model.History) { <li><span class="fw-semibold">@h.Action</span> by @(h.UserName ?? "system")<div class="text-muted">@h.CreatedLocal.ToString("dd MMM yyyy HH:mm")@(h.Details is null ? "" : " · " + h.Details)</div></li> }</ul> }
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="card mb-3"><div class="card-header">Follow-ups (@Model.FollowUps.Count)</div>
    @if (Model.FollowUps.Count == 0) { <div class="empty-state py-4"><i class="bi bi-calendar2"></i>No follow-ups.</div> }
    else { <div class="table-responsive"><table class="table table-hover"><tbody>
      @foreach (var f in Model.FollowUps) { <tr><td><a class="row-title" asp-route-controller="FollowUps" asp-route-action="Edit" asp-route-id="@f.FollowUpId" asp-route="default">@f.Subject</a><div class="sub-text">@f.FollowUpType · @f.AssignedToName</div></td>
        <td class="text-nowrap">@f.FollowUpDate.ToString("dd MMM yyyy")</td><td><span class="badge-soft badge-soft-@(f.IsOverdue ? "danger" : Ui.Badge(f.Status))">@(f.IsOverdue ? "Overdue" : f.Status)</span></td></tr> }
    </tbody></table></div> }
    </div>
    <div class="card"><div class="card-header">Activities (@Model.Activities.Count)</div>
    @if (Model.Activities.Count == 0) { <div class="empty-state py-4"><i class="bi bi-telephone"></i>No activities logged.</div> }
    else { <div class="table-responsive"><table class="table"><tbody>
      @foreach (var a in Model.Activities) { <tr><td><span class="row-title">@a.Subject</span><div class="sub-text">@a.ActivityType · @a.AssignedToName</div></td><td class="text-nowrap">@a.ActivityDate.ToString("dd MMM yyyy")</td><td><span class="badge-soft badge-soft-@Ui.Badge(a.Status)">@a.Status</span></td></tr> }
    </tbody></table></div> }
    </div>
  </div>
</div>
