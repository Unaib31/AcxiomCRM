@model ChangePasswordViewModel
@{ ViewData["Title"] = "Change password"; }
<div class="page-header"><div><h1>Change password</h1><div class="sub">Choose a strong password you have not used recently.</div></div></div>
<div class="card maxw-720"><div class="card-body">
<form method="post" asp-route-action="ChangePassword" novalidate asp-route="default">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
  <div class="row g-3">
    <crm-field for="CurrentPassword" type="password" col="col-12" autocomplete="current-password" />
    <crm-field for="NewPassword" type="password" col="col-md-6" autocomplete="new-password" hint="8+ characters, upper and lower case, a number and a symbol." />
    <crm-field for="ConfirmPassword" type="password" col="col-md-6" autocomplete="new-password" />
  </div>
  <div class="mt-4 d-flex gap-2"><button class="btn btn-primary" type="submit">Update password</button><a class="btn btn-outline-secondary" asp-route-action="Profile" asp-route="default">Cancel</a></div>
</form></div></div>
