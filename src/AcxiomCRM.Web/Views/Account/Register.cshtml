@model RegisterInput
@{ ViewData["Title"] = "Create account"; }
<h1 class="h3 fw-bold mb-1">Create your account</h1>
<p class="text-muted mb-4">New accounts start as <strong>Sales Executive</strong>. An administrator can change your role.</p>
<form method="post" asp-route-action="Register" novalidate asp-route="default">
  <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
  <div class="row g-3">
    <crm-field for="FullName" col="col-12" autocomplete="name" autofocus="true" />
    <crm-field for="Email" type="email" col="col-12" autocomplete="email" />
    <crm-field for="Password" type="password" col="col-12" autocomplete="new-password" hint="At least 8 characters with upper and lower case letters, a number and a symbol." />
    <crm-field for="ConfirmPassword" type="password" col="col-12" autocomplete="new-password" />
  </div>
  <button class="btn btn-primary w-100 py-2 mt-4" type="submit">Create account</button>
</form>
<p class="text-center text-muted mt-4 mb-0">Already registered? <a asp-route-action="Login" asp-route="default">Sign in</a></p>
