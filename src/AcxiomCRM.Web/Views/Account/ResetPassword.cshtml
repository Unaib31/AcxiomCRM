@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset password"; }
<h1 class="h3 fw-bold mb-1">Set a new password</h1>
<p class="text-muted mb-4">This link works once and expires soon.</p>
<form method="post" asp-route-action="ResetPassword" novalidate asp-route="default">
  <input type="hidden" asp-for="UserId" /><input type="hidden" asp-for="Token" />
  <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
  <div class="row g-3">
    <crm-field for="NewPassword" type="password" col="col-12" autocomplete="new-password" hint="8+ characters, upper and lower case, a number and a symbol." />
    <crm-field for="ConfirmPassword" type="password" col="col-12" autocomplete="new-password" />
  </div>
  <button class="btn btn-primary w-100 py-2 mt-4" type="submit">Reset password</button>
</form>
