@model ListViewModel<CustomerDto, CustomerQuery>
@{ ViewData["Title"] = "Customers"; var q = Model.Query; }
<div class="page-header">
  <div><h1>Customers</h1><div class="sub">@Model.Result.TotalCount customer@(Model.Result.TotalCount == 1 ? "" : "s")</div></div>
  <a class="btn btn-primary" asp-route-action="Create" asp-route="default"><i class="bi bi-plus-lg me-1"></i>New customer</a>
</div>
<div class="card mb-3"><form method="get" class="filter-bar row g-2 align-items-end">
  <div class="col-md-5"><label class="form-label small" for="search">Search</label><input id="search" name="search" value="@q.Search" class="form-control" placeholder="Name, email, phone or company" maxlength="100" /></div>
  <div class="col-md-3"><label class="form-label small" for="status">Status</label>
    <select id="status" name="status" class="form-select"><option value="">All statuses</option>@foreach (var s in Enum.GetValues<CustomerStatus>()) { <option value="@s" selected="@(q.Status == s)">@s</option> }</select></div>
  <div class="col-md-2"><label class="form-label small" for="assignedTo">Owner</label>
    <select id="assignedTo" name="assignedTo" class="form-select"><option value="">Anyone</option>@foreach (var o in Model.Owners) { <option value="@o.Id" selected="@(q.AssignedTo == o.Id)">@o.Name</option> }</select></div>
  <div class="col-md-2 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit">Filter</button><a class="btn btn-outline-secondary" asp-route-action="Index" aria-label="Clear filters" asp-route="default"><i class="bi bi-x-lg"></i></a></div>
</form></div>
<div class="card">
@if (Model.Result.Items.Count == 0) { <div class="empty-state"><i class="bi bi-people"></i><strong class="d-block text-body mb-1">No matching customers</strong>Try a different search or clear your filters.<div class="d-flex justify-content-center gap-3 mt-3"><a asp-route-action="Index" asp-route="default">Clear filters</a><a asp-route-action="Create" asp-route="default">New customer <i class="bi bi-arrow-right"></i></a></div></div> }
else
{
<div class="table-responsive"><table class="table table-hover">
  <thead><tr>
    <partial name="_SortTh" model='("Customer", "name", (string?)null)' />
    <partial name="_SortTh" model='("Company", "company", (string?)null)' />
    <th scope="col">Contact</th>
    <partial name="_SortTh" model='("Status", "status", (string?)null)' />
    <th scope="col">Owner</th>
    <partial name="_SortTh" model='("Created", "created", (string?)null)' />
    <th scope="col"><span class="visually-hidden">Actions</span></th>
  </tr></thead>
  <tbody>
  @foreach (var c in Model.Result.Items)
  {
    <tr>
      <td><a class="row-title" asp-route-action="Details" asp-route-id="@c.CustomerId" asp-route="default">@c.CustomerName</a><div class="sub-text">@c.CustomerCode</div></td>
      <td>@(c.CompanyName ?? "—")</td>
      <td>@c.Email<div class="sub-text">@c.Phone</div></td>
      <td><span class="badge-soft badge-soft-@Ui.Badge(c.Status)">@c.Status</span></td>
      <td>@c.AssignedToName</td>
      <td class="text-nowrap">@Clock.ToLocal(c.CreatedDate).ToString("dd MMM yyyy")</td>
      <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-secondary" asp-route-action="Edit" asp-route-id="@c.CustomerId" aria-label="Edit @c.CustomerName" asp-route="default"><i class="bi bi-pencil"></i></a></td>
    </tr>
  }
  </tbody></table></div>
  <partial name="_Pager" model="(Model.Result.Page, Model.Result.TotalPages, Model.Result.TotalCount, Model.Result.PageSize)" />
}
</div>
