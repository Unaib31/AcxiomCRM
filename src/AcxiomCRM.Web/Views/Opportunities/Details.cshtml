@model OpportunityDetailsViewModel
@{
  var o = Model.Opportunity; ViewData["Title"] = o.OpportunityName;
  var active = o.Stage is not (nameof(OpportunityStage.Won) or nameof(OpportunityStage.Lost));
  var stages = Enum.GetValues<OpportunityStage>().Where(s => s.ToString() != o.Stage).ToList();
}
<nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-route-action="Index" asp-route="default">Opportunities</a></li><li class="breadcrumb-item active" aria-current="page">@o.OpportunityCode</li></ol></nav>
<div class="page-header">
  <div><h1>@o.OpportunityName</h1><div class="sub"><a asp-route-controller="Customers" asp-route-action="Details" asp-route-id="@o.CustomerId" asp-route="default">@o.CustomerName</a> · <span class="badge-soft badge-soft-@Ui.Badge(o.Stage)">@o.Stage</span></div></div>
  <div class="d-flex flex-wrap gap-2">
    @if (active)
    {
      <a class="btn btn-outline-primary" asp-route-controller="FollowUps" asp-route-action="Create" asp-route-relatedType="Opportunity" asp-route-relatedId="@o.OpportunityId" asp-route="default"><i class="bi bi-calendar-plus me-1"></i>Schedule follow-up</a>
      <a class="btn btn-primary" asp-route-action="Edit" asp-route-id="@o.OpportunityId" asp-route="default"><i class="bi bi-pencil me-1"></i>Edit</a>
    }
    @if (Model.CanDelete)
    {
      <form method="post" asp-route-action="Delete" asp-route-id="@o.OpportunityId" data-confirm="Delete opportunity @o.OpportunityName?" data-confirm-title="Delete opportunity" data-confirm-ok="Delete" asp-route="default"><button class="btn btn-outline-danger" type="submit" data-no-lock><i class="bi bi-trash me-1"></i>Delete</button></form>
    }
  </div>
</div>
@if (active)
{
  <div class="card mb-3"><div class="card-body py-2 d-flex flex-wrap align-items-center gap-2">
    <span class="sub-text fw-semibold text-uppercase me-2">Move to stage</span>
    @foreach (var s in stages.Where(s => s is not (OpportunityStage.Won or OpportunityStage.Lost)))
    {
      <form method="post" asp-route-action="ChangeStage" asp-route-id="@o.OpportunityId" asp-route="default"><input type="hidden" name="Stage" value="@s" /><button class="btn btn-sm btn-outline-secondary" type="submit">@s</button></form>
    }
    <form method="post" asp-route-action="ChangeStage" asp-route-id="@o.OpportunityId" data-confirm="Mark this opportunity as Won? This is final." data-confirm-title="Mark as won" data-confirm-ok="Mark as won" data-confirm-class="btn-success" asp-route="default"><input type="hidden" name="Stage" value="Won" /><button class="btn btn-sm btn-success" type="submit" data-no-lock><i class="bi bi-trophy me-1"></i>Won</button></form>
    <form method="post" asp-route-action="ChangeStage" asp-route-id="@o.OpportunityId" data-confirm="Mark this opportunity as Lost? This is final." data-confirm-title="Mark as lost" data-confirm-ok="Mark as lost" asp-route="default"><input type="hidden" name="Stage" value="Lost" /><button class="btn btn-sm btn-danger" type="submit" data-no-lock><i class="bi bi-x-octagon me-1"></i>Lost</button></form>
  </div></div>
}
<div class="row g-3">
  <div class="col-lg-4">
    <div class="card mb-3"><div class="card-header">Details</div><div class="card-body"><dl class="detail-list mb-0">
      <dt>Amount</dt><dd class="h5">@Ui.Money(o.Amount)</dd>
      <dt>Probability / weighted</dt><dd>@o.Probability% · @Ui.Money(o.WeightedAmount)</dd>
      <dt>Expected close</dt><dd>@o.ExpectedCloseDate.ToString("dd MMM yyyy")</dd>
      <dt>Source</dt><dd>@(o.Source is null ? "—" : Ui.Spaced(o.Source))</dd>
      <dt>Owner</dt><dd>@o.AssignedToName</dd>
      <dt>Created</dt><dd>@Clock.ToLocal(o.CreatedDate).ToString("dd MMM yyyy")</dd>
      @if (o.ClosedDate is { } cd) { <dt>Closed</dt><dd>@Clock.ToLocal(cd).ToString("dd MMM yyyy")</dd> }
      @if (!string.IsNullOrEmpty(o.OutcomeNotes)) { <dt>Outcome</dt><dd class="pre-wrap">@o.OutcomeNotes</dd> }
      <dt>Notes</dt><dd class="pre-wrap mb-0">@(o.Notes ?? "—")</dd>
    </dl></div></div>
    <div class="card"><div class="card-header">History</div><div class="card-body">
      @if (Model.History.Count == 0) { <span class="text-muted">No recorded changes.</span> }
      else { <ul class="timeline small">@foreach (var h in Model.History) { <li><span class="fw-semibold">@h.Action</span> by @(h.UserName ?? "system")<div class="text-muted">@h.CreatedLocal.ToString("dd MMM yyyy HH:mm")@(h.Details is null ? "" : " · " + h.Details)</div></li> }</ul> }
    </div></div>
  </div>
  <div class="col-lg-8">
    <div class="card"><div class="card-header">Follow-ups (@Model.FollowUps.Count)</div>
    @if (Model.FollowUps.Count == 0) { <div class="empty-state py-4"><i class="bi bi-calendar2"></i>No follow-ups.</div> }
    else { <div class="table-responsive"><table class="table table-hover"><tbody>
      @foreach (var f in Model.FollowUps) { <tr><td><a class="row-title" asp-route-controller="FollowUps" asp-route-action="Edit" asp-route-id="@f.FollowUpId" asp-route="default">@f.Subject</a><div class="sub-text">@f.FollowUpType · @f.AssignedToName</div></td>
        <td class="text-nowrap">@f.FollowUpDate.ToString("dd MMM yyyy")</td><td><span class="badge-soft badge-soft-@(f.IsOverdue ? "danger" : Ui.Badge(f.Status))">@(f.IsOverdue ? "Overdue" : f.Status)</span></td></tr> }
    </tbody></table></div> }
    </div>
  </div>
</div>
