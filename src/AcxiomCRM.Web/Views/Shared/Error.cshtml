@model ErrorViewModel
@{ ViewData["Title"] = Model.Title; }
<div class="text-center py-5 mx-auto narrow">
  <div class="display-1 fw-bold text-primary">@Model.Code</div>
  <h1 class="h3 mb-2">@Model.Title</h1>
  <p class="text-muted">@Model.Message</p>
  <div class="d-flex gap-2 justify-content-center">
    <a class="btn btn-primary" href="/">Go to dashboard</a>
    <a class="btn btn-outline-secondary" href="javascript:history.back()">Go back</a>
  </div>
  @if (!string.IsNullOrEmpty(Model.TraceId)) { <p class="small text-muted mt-4">Reference: @Model.TraceId</p> }
</div>
