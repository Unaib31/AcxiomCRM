@* Model: (int Page, int TotalPages, int TotalCount, int PageSize). Preserves every current query-string filter. *@
@model (int Page, int TotalPages, int TotalCount, int PageSize)
@{
  string Url(int p)
  {
    var qs = Context.Request.Query.Where(k => !k.Key.Equals("page", StringComparison.OrdinalIgnoreCase))
      .SelectMany(k => k.Value.Select(v => $"{Uri.EscapeDataString(k.Key)}={Uri.EscapeDataString(v ?? "")}")).ToList();
    qs.Add($"page={p}");
    return Context.Request.Path + "?" + string.Join("&", qs);
  }
  var start = Math.Max(1, Model.Page - 2); var end = Math.Min(Model.TotalPages, Model.Page + 2);
}
@if (Model.TotalCount > 0)
{
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 px-3 py-2 border-top">
    <span class="sub-text">Showing @((Model.Page - 1) * Model.PageSize + 1)–@Math.Min(Model.Page * Model.PageSize, Model.TotalCount) of @Model.TotalCount</span>
    @if (Model.TotalPages > 1)
    {
      <nav aria-label="Pagination">
        <ul class="pagination pagination-sm mb-0">
          <li class="page-item @(Model.Page <= 1 ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page - 1)" aria-label="Previous">&laquo;</a></li>
          @if (start > 1) { <li class="page-item"><a class="page-link" href="@Url(1)">1</a></li> @if (start > 2) { <li class="page-item disabled"><span class="page-link">…</span></li> } }
          @for (var i = start; i <= end; i++) { <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="@Url(i)" @(i == Model.Page ? "aria-current=page" : "")>@i</a></li> }
          @if (end < Model.TotalPages) { @if (end < Model.TotalPages - 1) { <li class="page-item disabled"><span class="page-link">…</span></li> } <li class="page-item"><a class="page-link" href="@Url(Model.TotalPages)">@Model.TotalPages</a></li> }
          <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")"><a class="page-link" href="@Url(Model.Page + 1)" aria-label="Next">&raquo;</a></li>
        </ul>
      </nav>
    }
  </div>
}
