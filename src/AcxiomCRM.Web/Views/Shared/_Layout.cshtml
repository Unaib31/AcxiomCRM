@using Microsoft.Extensions.Options
@using AcxiomCRM.Application.Security
@inject IOptions<SecurityOptions> SecOpt
@{
    var ctrl = (ViewContext.RouteData.Values["controller"] as string) ?? "";
    var action = (ViewContext.RouteData.Values["action"] as string) ?? "";
    var sec = SecOpt.Value;
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var role = isAdmin ? RoleNames.Admin : User.IsInRole(RoleNames.Manager) ? RoleNames.Manager : RoleNames.SalesExecutive;
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "";
    string Active(string c, string? a = null) => ctrl == c && (a is null || action == a) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex,nofollow" />
  <title>@(ViewData["Title"] is string t ? t + " · " : "")AcxiomCRM</title>
  <script src="~/js/theme.js"></script>
  <link rel="stylesheet" href="~/lib/bootstrap/bootstrap.min.css" />
  <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="app-shell">
  <aside class="app-sidebar" id="app-sidebar" aria-label="Main navigation">
    <a class="brand" asp-route-controller="Dashboard" asp-route-action="Index" asp-route="default"><span class="brand-mark">A</span> <span>acxiom<span class="brand-caption">Customer workspace</span></span></a>
    <nav class="nav flex-column">
      <div class="nav-section">Overview</div>
      <a class="nav-link @Active("Dashboard")" asp-route-controller="Dashboard" asp-route-action="Index" asp-route="default"><i class="bi bi-speedometer2"></i> Dashboard</a>
      <div class="nav-section">Sales</div>
      <a class="nav-link @Active("Customers")" asp-route-controller="Customers" asp-route-action="Index" asp-route="default"><i class="bi bi-people"></i> Customers</a>
      <a class="nav-link @Active("Leads")" asp-route-controller="Leads" asp-route-action="Index" asp-route="default"><i class="bi bi-funnel"></i> Leads</a>
      <a class="nav-link @Active("Opportunities", "Index") @Active("Opportunities", "Details") @Active("Opportunities", "Form") @Active("Opportunities", "Create") @Active("Opportunities", "Edit")" asp-route-controller="Opportunities" asp-route-action="Index" asp-route="default"><i class="bi bi-briefcase"></i> Opportunities</a>
      <a class="nav-link @Active("Opportunities", "Pipeline")" asp-route-controller="Opportunities" asp-route-action="Pipeline" asp-route="default"><i class="bi bi-kanban"></i> Pipeline Board</a>
      <div class="nav-section">Engagement</div>
      <a class="nav-link @Active("FollowUps")" asp-route-controller="FollowUps" asp-route-action="Index" asp-route="default"><i class="bi bi-calendar-check"></i> Follow-Ups</a>
      <a class="nav-link @Active("Activities")" asp-route-controller="Activities" asp-route-action="Index" asp-route="default"><i class="bi bi-telephone"></i> Activities</a>
      <div class="nav-section">Insights</div>
      <a class="nav-link @Active("Reports")" asp-route-controller="Reports" asp-route-action="Index" asp-route="default"><i class="bi bi-bar-chart-line"></i> Reports</a>
      @if (User.CanViewUsers(sec) || User.CanViewAudit(sec))
      {
        <div class="nav-section">Administration</div>
        @if (User.CanViewUsers(sec)) { <a class="nav-link @Active("Users", "Index") @Active("Users", "Details") @Active("Users", "Form") @Active("Users", "Create") @Active("Users", "Edit")" asp-route-controller="Users" asp-route-action="Index" asp-route="default"><i class="bi bi-person-gear"></i> Users</a> }
        @if (isAdmin) { <a class="nav-link @Active("Users", "Roles")" asp-route-controller="Users" asp-route-action="Roles" asp-route="default"><i class="bi bi-shield-lock"></i> Roles &amp; Permissions</a> }
        @if (User.CanViewAudit(sec)) { <a class="nav-link @Active("Audit")" asp-route-controller="Audit" asp-route-action="Index" asp-route="default"><i class="bi bi-journal-text"></i> Audit Log</a> }
      }
    </nav>
    <div class="sidebar-footer"><span class="workspace-symbol"><i class="bi bi-buildings"></i></span><span><strong>Acxiom workspace</strong><span class="d-block">@RoleNames.Display(role) access</span></span></div>
  </aside>
  <div class="sidebar-backdrop" id="sidebar-backdrop"></div>

  <div class="app-main">
    <header class="app-header">
      <button class="icon-btn d-lg-none" type="button" data-sidebar-toggle aria-label="Toggle navigation" aria-controls="app-sidebar" aria-expanded="false"><i class="bi bi-list fs-4"></i></button>
      <div class="header-location d-none d-xl-flex"><span>Workspace</span><i class="bi bi-chevron-right"></i><strong>@(ViewData["Title"] ?? "Overview")</strong></div>
      <form class="global-search" role="search" method="get" asp-route-controller="Search" asp-route-action="Index" asp-route="default">
        <i class="bi bi-search"></i>
        <input class="form-control" type="search" name="q" minlength="2" maxlength="100" placeholder="Search your workspace…" aria-label="Global search" autocomplete="off" />
      <kbd class="search-shortcut" aria-hidden="true">/</kbd>
      </form>
      <div class="ms-auto d-flex align-items-center gap-1">
        <button class="icon-btn" id="theme-toggle" type="button" aria-label="Toggle dark mode"><i class="bi bi-circle-half fs-5"></i></button>
        <vc:notifications />
        <div class="dropdown">
          <button class="btn btn-link text-decoration-none d-flex align-items-center gap-2 text-body px-2" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar">@Ui.Initials(fullName)</span>
            <span class="d-none d-md-block text-start lh-sm"><span class="d-block fw-semibold small">@fullName</span><span class="d-block text-muted text-xxs">@RoleNames.Display(role)</span></span>
            <i class="bi bi-chevron-down small"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow">
            <li><a class="dropdown-item" asp-route-controller="Account" asp-route-action="Profile" asp-route="default"><i class="bi bi-person me-2"></i>My profile</a></li>
            <li><a class="dropdown-item" asp-route-controller="Account" asp-route-action="ChangePassword" asp-route="default"><i class="bi bi-key me-2"></i>Change password</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li>
              <form method="post" asp-route-controller="Account" asp-route-action="Logout" asp-route="default"><button class="dropdown-item text-danger" type="submit" data-no-lock><i class="bi bi-box-arrow-right me-2"></i>Sign out</button></form>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <main class="app-content" id="main">
      <partial name="_Alerts" />
      @RenderBody()
    </main>
    <footer class="app-footer d-flex justify-content-between flex-wrap gap-2">
      <span>© @Clock.Today.Year AcxiomCRM</span>
      <span><i class="bi bi-shield-check me-1"></i> Secure customer workspace</span>
    </footer>
  </div>
</div>
<partial name="_ConfirmModal" />
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/jquery-validation/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
<script src="~/lib/bootstrap/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
<script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
